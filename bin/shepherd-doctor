#!/usr/bin/env bash
#
# shepherd-doctor — environment diagnostics for Shepherd (Herdr orchestrator for pi)
#
# Runs entirely with the shell + standard POSIX utilities. Does NOT launch pi.
# Exits nonzero only when one or more hard failures are found; warnings exit 0.
#
# Usage:
#   shepherd-doctor            # run all checks
#   shepherd-doctor --no-color # disable ANSI colours
#   shepherd-doctor --help     # this help
#
# To run directly from a checkout:
#   ./bin/shepherd-doctor
#   SHEPHERD_DIR_OVERRIDE=/path/to/shepherd ./bin/shepherd-doctor
#
# Exit codes:
#   0  no hard failures (warnings are acceptable)
#   1  one or more hard failures — Shepherd cannot run correctly

set -uo pipefail

# --- locate the shepherd project dir from this script's path ----------------
resolve_script() {
  local src="$1"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
    src="$(readlink "$src")" || break
    case "$src" in
      /*) ;;
      *) src="$dir/$src" ;;
    esac
  done
  printf '%s' "$src"
}

SCRIPT_PATH="$(resolve_script "${BASH_SOURCE[0]:-$0}")"
SHEPHERD_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." >/dev/null 2>&1 && pwd)"
# Allow explicit override (used by tests / wrappers that already know the dir)
SHEPHERD_DIR="${SHEPHERD_DIR_OVERRIDE:-$SHEPHERD_DIR}"

# --- toggle colours ----------------------------------------------------------
USE_COLOR=1
for arg in "$@"; do
  case "$arg" in
    --no-color) USE_COLOR=0 ;;
    --help|-h)
      sed -n '2,30p' "$0"
      exit 0
      ;;
  esac
done

if [ "$USE_COLOR" -eq 1 ] && [ -t 1 ]; then
  C_GREEN=$'\033[1;32m'; C_YELLOW=$'\033[1;33m'; C_RED=$'\033[1;31m'
  C_BLUE=$'\033[1;34m';  C_BOLD=$'\033[1m';     C_RESET=$'\033[0m'
else
  C_GREEN=''; C_YELLOW=''; C_RED=''; C_BLUE=''; C_BOLD=''; C_RESET=''
fi

# --- counters ----------------------------------------------------------------
PASS_COUNT=0
WARN_COUNT=0
FAIL_COUNT=0

hdr()   { printf "\n%s== %s ==%s\n" "$C_BLUE" "$1" "$C_RESET"; }
info()  { printf "    %s%s%s\n" "$C_BOLD" "$1" "$C_RESET"; }
pass()  { printf "  %sPASS%s  %s\n" "$C_GREEN" "$C_RESET" "$1"; PASS_COUNT=$((PASS_COUNT+1)); }
warn()  { printf "  %sWARN%s  %s\n" "$C_YELLOW" "$C_RESET" "$1"; WARN_COUNT=$((WARN_COUNT+1)); }
fail()  { printf "  %sFAIL%s  %s\n" "$C_RED" "$C_RESET" "$1";   FAIL_COUNT=$((FAIL_COUNT+1)); }

# --- helper: best-effort version probe (never fails the script) --------------
version_of() {
  local v
  v="$("$1" --version 2>/dev/null | head -n1 | tr -d '\r')" || v=""
  [ -n "$v" ] || v="$("$1" -V 2>/dev/null | head -n1 | tr -d '\r')" || v=""
  [ -n "$v" ] || v="$("$1" version 2>/dev/null | head -n1 | tr -d '\r')" || v=""
  printf '%s' "$v"
}

# =============================================================================
# Environment
# =============================================================================
hdr "Environment"
if [ "${HERDR_ENV:-0}" = "1" ]; then
  pass "HERDR_ENV=1 — running inside a Herdr session"
  info "workspace=${HERDR_WORKSPACE_ID:-?}  tab=${HERDR_TAB_ID:-?}  pane=${HERDR_PANE_ID:-?}"
else
  warn "HERDR_ENV is not set — running outside Herdr"
  info "the orchestrator role only applies inside a herdr session; doctor itself is fine here"
fi

# =============================================================================
# Shepherd project
# =============================================================================
hdr "Shepherd project"
if [ -d "$SHEPHERD_DIR" ]; then
  pass "shepherd directory exists: $SHEPHERD_DIR"
else
  fail "shepherd directory missing: $SHEPHERD_DIR"
fi

if [ -f "$SHEPHERD_DIR/AGENTS.md" ]; then
  pass "AGENTS.md present (orchestrator system prompt)"
else
  fail "AGENTS.md missing — pi will not load the orchestrator system prompt"
fi

# =============================================================================
# Required commands
#   hard  = Shepherd cannot run without it
#   warn  = a sub-feature is degraded but the orchestrator still runs
# =============================================================================
hdr "Required commands"

check_cmd() {
  local name="$1" severity="$2" what="$3"
  if command -v "$name" >/dev/null 2>&1; then
    local v
    v="$(version_of "$name")"
    if [ -n "$v" ]; then
      pass "$name found ($v)"
    else
      pass "$name found"
    fi
  else
    if [ "$severity" = "hard" ]; then
      fail "$name not found on PATH — $what"
    else
      warn "$name not found on PATH — $what"
    fi
  fi
}

check_cmd git       hard "required to install/update shepherd and run git operations"
check_cmd pi        hard "the orchestrator itself runs as pi"
check_cmd python3   warn "required by bin/herdr-summary (fleet summaries)"
check_cmd node      warn "pi extensions (.ts) are transpiled at runtime"
check_cmd herdr     warn "required to drive the fleet (only meaningful inside Herdr)"

# =============================================================================
# Project-local extensions / agents
# =============================================================================
hdr "Project-local extensions / agents"

expect_present() {
  local rel="$1" what="$2"
  local path="$SHEPHERD_DIR/$rel"
  if [ -f "$path" ]; then
    pass "$rel present ($what)"
  else
    warn "$rel missing — $what degraded"
  fi
}

expect_present "bin/herdr-summary"                "fleet summaries"
expect_present ".pi/extensions/herdr-agents.ts"    "/agents dashboard + @herdr: mentions"
expect_present ".pi/extensions/fleet-activity.ts" "working-indicator fleet status"
expect_present ".pi/extensions/fleet-ledger.ts"  "durable dispatch ledger tool + /tasks"
expect_present ".pi/agents/prompt-refiner.md"     "prompt-refiner subagent"

# =============================================================================
# Fleet ledger directory
#   Must be creatable/writable WITHOUT destructively changing existing data.
#   We probe by writing (and immediately removing) a uniquely-named temp file.
# =============================================================================
hdr "Fleet ledger"
LEDGER_DIR="${HERDR_LEDGER_DIR:-$HOME/.herdr-ledger}"
info "ledger dir: $LEDGER_DIR"

probe_writable() {
  # $1 = dir to probe. Creates it if missing. Returns 0 if writable.
  # Cleans up the probe file. Does NOT delete the dir itself unless WE created it.
  local dir="$1" created=0 probe
  if [ ! -d "$dir" ]; then
    if ! mkdir -p "$dir" 2>/dev/null; then
      return 1
    fi
    created=1
  fi
  probe="$dir/.shepherd-doctor-probe.$$"
  if ( : > "$probe" ) 2>/dev/null; then
    rm -f "$probe"
    if [ "$created" -eq 1 ]; then
      rmdir "$dir" 2>/dev/null || true   # clean up the dir we just made, if empty
    fi
    return 0
  else
    if [ "$created" -eq 1 ]; then
      rmdir "$dir" 2>/dev/null || true   # leave no trace of a failed create
    fi
    return 1
  fi
}

if [ -d "$LEDGER_DIR" ]; then
  pass "ledger directory already exists"
  if probe_writable "$LEDGER_DIR"; then
    pass "ledger directory is writable (probe cleaned up, no data changed)"
  else
    fail "ledger directory not writable: $LEDGER_DIR"
  fi
else
  if probe_writable "$LEDGER_DIR"; then
    pass "ledger directory creatable and writable (no data changed)"
  else
    fail "cannot create or write ledger directory: $LEDGER_DIR"
  fi
fi

# =============================================================================
# Summary
# =============================================================================
hdr "Summary"
printf "  %sPASS=%d%s   %sWARN=%d%s   %sFAIL=%d%s\n" \
  "$C_GREEN" "$PASS_COUNT" "$C_RESET" \
  "$C_YELLOW" "$WARN_COUNT" "$C_RESET" \
  "$C_RED" "$FAIL_COUNT" "$C_RESET"

if [ "$FAIL_COUNT" -gt 0 ]; then
  printf "\n%sShepherd is NOT ready: %d hard failure(s).%s\n" \
    "$C_RED" "$FAIL_COUNT" "$C_RESET"
  exit 1
fi

if [ "$WARN_COUNT" -gt 0 ]; then
  printf "\n%sShepherd is ready with %d warning(s).%s\n" \
    "$C_YELLOW" "$WARN_COUNT" "$C_RESET"
  exit 0
fi

printf "\n%sShepherd is ready. No problems found.%s\n" "$C_GREEN" "$C_RESET"
exit 0
